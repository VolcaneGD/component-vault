{
  "name": "component-vault",
  "version": "1.0.5",
  "description": "A local-first Windows desktop workspace for reusable HTML components",
  "productName": "Component Vault",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder --win nsis zip --x64",
    "package:dir": "npm run build && electron-builder --dir --win --x64"
  },
  "keywords": [],
  "author": "Component Vault contributors",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chardet": "^2.2.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  }
}
